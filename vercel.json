{
  "functions": {
    "api/tts.js": {
      "includeFiles": "{voices/**,node_modules/sherpa-onnx-linux-x64/**}",
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    }
  ]
}
